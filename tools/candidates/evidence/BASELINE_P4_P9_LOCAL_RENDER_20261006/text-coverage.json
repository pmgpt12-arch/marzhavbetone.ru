        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:2/cell:0",
        "source_text": "{{ИНН_КРЕДИТОРА}}, {{ОГРН_КРЕДИТОРА}}",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:2/cell:1",
        "source_text": "ИНН и ОГРН вашей организации",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:2/cell:2",
        "source_text": "выписка ЕГРЮЛ",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:3/cell:0",
        "source_text": "{{АДРЕС_КРЕДИТОРА}}",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:3/cell:1",
        "source_text": "Юридический адрес вашей организации",
        "present_in_pdf_normalized": true
      },
      {
