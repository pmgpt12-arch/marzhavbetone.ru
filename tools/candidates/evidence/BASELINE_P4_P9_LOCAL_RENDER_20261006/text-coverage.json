      {
        "locator": "table:1/row:8/cell:0",
        "source_text": "{{ДОЛЖНОСТЬ_ПОДПИСАНТА}}, {{ФИО_ПОДПИСАНТА}}",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:8/cell:1",
        "source_text": "Кто подписывает от вашей организации",
        "present_in_pdf_normalized": true
      },
      {
