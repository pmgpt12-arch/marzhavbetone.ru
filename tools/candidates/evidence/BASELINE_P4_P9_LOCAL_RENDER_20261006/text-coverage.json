        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:6/cell:1",
        "source_text": "ИНН и ОГРН должника",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:6/cell:2",
        "source_text": "выписка ЕГРЮЛ, публикация сведений",
        "present_in_pdf_normalized": true
