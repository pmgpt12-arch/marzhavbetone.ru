        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:9/cell:1",
        "source_text": "«действующего на основании Устава» либо реквизиты доверенности",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:1/row:9/cell:2",
        "source_text": "устав, доверенность",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:2/row:0/cell:0",
        "source_text": "Поле",
        "present_in_pdf_normalized": true
      },
      {
        "locator": "table:2/row:0/cell:1",
        "source_text": "Что подставить",
        "present_in_pdf_normalized": true
      },
      {
