  {
    "document": "products-storage/08-pto-bez-zamechaniy/03-perechen-vozmozhnyh-zamechaniy.docx",
    "file_sha256": "98cde059fdb372ee4e4c9dde66bf5a2b571cd83e864af85059174b01cf354798",
