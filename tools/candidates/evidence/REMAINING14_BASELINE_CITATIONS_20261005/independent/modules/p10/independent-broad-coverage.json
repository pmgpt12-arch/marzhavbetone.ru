        "span": [
          308,
          310
        ],
        "overlapping_records": [
          "p10-ref-0020"
        ]
      }
    ]
  },
  {
    "document": "products-storage/15-otvet-na-pretenziyu-baza/39-vozrazhenie-na-zachet-uderzhanie.docx",
    "file_sha256": "6d3b2eb3280ddc5c68418a50bb421979a128f328b3f0e25963ab2d6bf461d092",
    "native_locator": [
      "docx",
      "word/document.xml",
      "/document/body[1]/p[5]"
    ],
    "text": "Письменно не согласиться с объявленным зачётом или удержанием неустойки из оплаты — до того, как молчание или акт сверки без оговорок превратятся в согласие. Молчаливое согласие рискует правом на судебное снижение несоразмерной неустойки (ст. 333 ГК РФ).",
