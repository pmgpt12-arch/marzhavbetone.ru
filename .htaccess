# КЕШИРОВАНИЕ СТАТИКИ И РЕДИРЕКТЫ СХЕМЫ
# Залейте этот файл в /www/marzhavbetone.ru

# Здесь стояло «редиректы настроены в панели» — замер 14.08.2026 показал,
# что это не так: http:// и www. отдавали 200 вместо 301 (живой аудит,
# content/metrics/seo-live-audit-2026-08-14.md), то есть сайт существовал
# в четырёх версиях. Canonical склеивал их для поисковика, но вес и обход
# делились.
#
# Правила ниже устроены отказобезопасно. www → без www ходит по имени
# хоста и петли дать не может. https-редирект срабатывает ТОЛЬКО по явному
# заголовку прокси X-Forwarded-Proto: http — reg.ru терминирует SSL на
# своём фронте, и проверять %{HTTPS} на бэкенде нельзя (он там всегда off,
# это петля). Если прокси заголовок не передаёт, правило просто молчит —
# сайт жив, а редирект добирается в панели; проверка — повторный прогон
# seo-audit.yml.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.marzhavbetone\.ru$ [NC]
    RewriteRule ^(.*)$ https://marzhavbetone.ru/$1 [R=301,L]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://marzhavbetone.ru/$1 [R=301,L]
</IfModule>

# Внутренние документы не отдаём, даже если файл случайно оказался в
# webroot: список исключений в deploy.yml — единственная защита, и одной
# забытой строки в нём хватает, чтобы выложить наружу рабочие заметки.
# Синтаксис зависит от версии Apache, а ошибка в .htaccess роняет весь
# сайт в 500 — поэтому обе ветки под проверкой модуля.
<FilesMatch "\.(md|markdown)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ЗАКАЗЫ И МАСТЕРА ТОВАРОВ НАРУЖУ НЕ ОТДАЮТСЯ.
#
# Файл заказа `orders/order_*.json` содержит почту, телефон И токен выдачи —
# тот самый, который `download.php` сверяет перед тем, как отдать оплаченный
# товар. Один прочитанный файл заказа это и утечка персональных данных, и
# бесплатный доступ к платному товару.
#
# Запрет стоит ЗДЕСЬ, а не в самом каталоге, и это вынужденно: `orders` и
# `products-storage` перечислены в исключениях деплоя (deploy.yml), на сервер
# из репозитория не едут и своего `.htaccess` получить не могут. `orders`
# вообще создаётся на сервере вызовом `mkdir` из `config.php`.
#
# Имя файла заказа защитой не является: `substr(uniqid(), -6)` это младшие
# разряды времени в микросекундах, а не случайность, и вместе с
# `date('Ymd_His')` в том же имени оно перебираемо. Настоящее решение —
# вынести заказы за корень сайта; до него этот запрет единственное, что
# стоит между чужим любопытством и почтой покупателя.
#
# Обе ветки под проверкой модуля: ошибка в .htaccess роняет весь сайт в 500.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^orders(/|$) - [F,L]
    RewriteRule ^products-storage(/|$) - [F,L]
</IfModule>

# Листинг каталогов: при включённом имена файлов заказов не надо угадывать —
# сервер перечислит их сам.
#
# Здесь `IndexIgnore *`, а НЕ `Options -Indexes`, и это не вкус. `Options` в
# .htaccess действует только при `AllowOverride Options`; если хостинг его не
# даёт, Apache отвечает 500 на ВЕСЬ САЙТ. Проверить это отсюда нечем — домен
# закрыт политикой шлюза, — а ронять живой сайт ради укрепления, которое здесь
# лишь второй слой, нельзя. `IndexIgnore` живёт в классе `Indexes`, и он на
# этом хостинге заведомо разрешён: рядом работает `ExpiresActive` из того же
# класса. Первым слоем стоит запрет выше: он отдаёт 403 и на сам каталог.
#
# Полноценный `Options -Indexes` — шаг настройки сервера, он в плане
# устранения, а не в этом файле.
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 1 hour"
    ExpiresByType text/css                 "access plus 1 week"
    ExpiresByType application/javascript   "access plus 1 week"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/gif                "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType application/pdf          "access plus 1 week"
    ExpiresByType font/woff2               "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(pdf|zip|doc|docx|xls|xlsx)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ПОСТОЯННЫЕ РЕДИРЕКТЫ УДАЛЁННЫХ СТРАНИЦ
#
# Здесь только те, что появляются вместе с удалением страницы из репозитория:
# страница уходит и адрес уходит одним коммитом, иначе редирект забывают.
# Общие правила сайта по-прежнему в панели хостинга.
#
# 01.08.2026. Разбор про гарантийное удержание на 183 слова снят решением
# владельца: в его заголовке стояла доля числом, а размер удержания в каждом
# договоре свой — заголовок обещал читателю чужой договор. Кластер закрыт
# тремя полными разборами, и адрес ведёт на тот из них, что объясняет
# механизм. Редирект обязателен: на старый адрес ведёт ссылка из уже
# опубликованного рилса, её задним числом не поменять.
<IfModule mod_alias.c>
    Redirect 301 /articles/garantiynoe-uderzhanie.html /articles/garantiynoe-uderzhanie-chto-eto.html

    # Реквизиты жили отдельной страницей-заглушкой с <meta http-equiv=
    # "refresh"> и canonical на контакты. Заглушка отдавала 200: для
    # робота это страница, а не склейка, и обрабатывается она хуже 301.
    # Замер 14.08.2026: на неё не ведёт ни одна ссылка сайта и её нет в
    # карте — риск переезда нулевой, а сигнал становится однозначным.
    Redirect 301 /rekvizity.html /contacts.html
</IfModule>
