orders/
*.log

# Собирается генератором при деплое (tools/build_rss.py)
rss.xml

# Кэш Python от скриптов в tools/
__pycache__/

# Карточки карусели собираются генератором (tools/build_cards.py)
content/social/cards/

# Remotion: зависимости и рендеры (tools/remotion)
tools/remotion/node_modules/
tools/remotion/out/

# Личные настройки сессии: набор MCP и разрешения — у каждого свои
.claude/settings.local.json

# Рабочие копии исполнителей: чужие деревья того же репозитория
.claude/worktrees/

# Журнал решений моста Agent → маршрутизатор: посессионный
data/ai/bridge/*.jsonl

# Кэш озвучки роликов: синтез платный, но файл пересобирается
media/voice/

# Окружение под вырезку кадров референсов: живёт на машине раннера,
# в репозиторий не кладётся.
.venv-frames/
.ffmpeg-cache/

# Внутренние материалы — только локально
content/
data/
reports/
research/
docs/
.claude/
CLAUDE.md
DEPLOY.md

# Единственное исключение из `data/`: шапка сайта. Это меню, бренд и ссылки,
# видные любому посетителю, а не внутренний материал. Без него
# `tools/check_nav.py` падает на FileNotFoundError, и гейт шапки в CI не
# исполняется вовсе — то есть закрытость этого файла ничего не защищает и
# стоит непроверенной шапки на 84 страницах.
#
# Открывается ровно один путь. Git не заходит внутрь игнорируемого каталога,
# поэтому исключение перечисляет всю цепочку: сам каталог, его содержимое,
# затем файл. Проверка границы — `tools/test_published_data.py`.
!data/
data/*
!data/site/
data/site/*
!data/site/navigation.yaml
