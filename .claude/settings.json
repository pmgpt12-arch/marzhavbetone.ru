{
  "permissions": {
    "allow": [
      "Bash(python3 tools/check_products.py:*)",
      "Bash(python3 tools/check_packages.py:*)",
      "Bash(python3 tools/check_covers.py:*)",
      "Bash(python3 tools/check_reel.py:*)",
      "Bash(python3 tools/dzen_channel.py:*)",
      "Bash(python3 tools/build_free_zips.py:*)",
      "Bash(python3 tools/hook_checks.py:*)",
      "Bash(php -l:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./config.php)",
      "Read(./orders/**)",
      "Read(./products-storage/**/*.zip)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 tools/check_backlog.py --next",
            "timeout": 30,
            "statusMessage": "Что можно брать сейчас"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/agent_bridge.py\" hook",
            "timeout": 20,
            "statusMessage": "Выбор модели исполнителю"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/hook_checks.py\" 2>/dev/null || true",
            "timeout": 90,
            "statusMessage": "Проверки репозитория"
          }
        ]
      }
    ]
  }
}
